[credential "https://github.com"]
	helper = 
	helper = !/nix/store/mb9j8sk0y7i4mxzswp331zfm9mlyjd2w-gh-2.102.0/bin/.gh-wrapped auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/nix/store/mb9j8sk0y7i4mxzswp331zfm9mlyjd2w-gh-2.102.0/bin/.gh-wrapped auth git-credential
[user]
	name = Rayzerrek
	email = rayserrek@gmail.com
	signingkey = /home/nixos/.ssh/id_ed25519.pub
[gpg]
	format = ssh
[commit]
	gpgsign = true
[gpg "ssh"]
	allowedSignersFile = /home/nixos/.ssh/allowed_signers
