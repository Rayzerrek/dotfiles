{
  "terminal.integrated.fontFamily": "Cascadia Code NF",
  "editor.fontFamily": "FiraCode Nerd Font",
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "file",
  "[typescript][jsonc][json][typescriptreact][javascriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.codeActionsOnSave": {
      "source.fixAll.oxc": "always",
    },
  },
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "remote.autoForwardPortsSource": "hybrid",
  "json.schemaDownload.trustedDomains": {
    "https://developer.microsoft.com/json-schemas/": true,
    "https://json-schema.org/": true,
    "https://json.schemastore.org/": true,
    "https://raw.githubusercontent.com/devcontainers/spec/": true,
    "https://raw.githubusercontent.com/microsoft/vscode/": true,
    "https://schemastore.azurewebsites.net/": true,
    "https://ui.shadcn.com": true,
    "https://www.schemastore.org/": true,
  },
  "terminal.integrated.commandsToSkipShell": [
    "kilo-code.new.agentManagerOpen",
    "kilo-code.new.agentManager.showTerminal",
  ],
  "terminal.integrated.profiles.windows": {
    "PowerShell": {
      "path": "C:\\Program Files\\PowerShell\\7\\pwsh.exe",
    },
    "Command Prompt": {
      "path": [
        "${env:windir}\\Sysnative\\cmd.exe",
        "${env:windir}\\System32\\cmd.exe",
      ],
      "args": [],
      "icon": "terminal-cmd",
    },
    "Git Bash": {
      "source": "Git Bash",
      "icon": "terminal-git-bash",
    },
    "Nushell": {
      "path": "C:\\Users\\kacpe\\scoop\\apps\\nu\\current\\nu.exe",
      "args": [],
    },
  },
  "terminal.integrated.defaultProfile.windows": "Nushell",
  "workbench.iconTheme": "symbols",
  "github.copilot.enable": {
    "typescript": true,
  },
  "github.copilot.nextEditSuggestions.enabled": true,
  "workbench.colorTheme": "Light 2026",
}
